<?xml version="1.0"?>
<sdf version="1.10">
    <model name='pail'>
        <link name='cube'>
            <pose relative_to='__model__'>0 0 0 0 0 0</pose>
            <visual name='visual'>
                <geometry>
                    <box>
                        <size>1.0 1.0 1.0</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.0 0.0 1.0 1</ambient>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                    <specular>0.0 0.0 1.0 1</specular>
                </material>
            </visual>

            <collision name='collision'>
                <geometry>
                    <box>
                        <size>1.0 1.0 1.0</size>
                    </box>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>