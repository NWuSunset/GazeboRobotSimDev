<?xml version="1.0"?>
<sdf version="1.8">
    <model name='ball'>

        <link name='sphere'>
            <visual name='visual'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient> <!-- Red RGBA color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>

            <collision name='collision'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>