<?xml version="1.0"?>
<sdf version="1.10">
    <model name='ball'>
        <static>false</static>

        <link name='sphere'>
            <inertial>
                <mass>0.5</mass>
                <inertia>
                    <ixx>0.05</ixx>
                    <iyy>0.05</iyy>
                    <izz>0.05</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>

            <visual name='visual'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient> <!-- Red RGBA color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>

            <collision name='collision'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>