<?xml version="1.0" ?>

<!-- URDF file for robot-->
 <robot name="differential_drive_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--Gometry and constants-->
    <xacro:property name="pi_const" value="3.14159265" />    

    <!--Body dimensions in meters-->
    <xacro:property name="a" value="1"/>
    <xacro:property name="b" value="0.3"/>
    <xacro:property name="c" value="0.6" />

    <!--Wheel + caster dimension-->

    <!-- wjheel and caster radius-->
    <xacro:property name="r" value="0.15" />

    <!-- wheel width-->
     <xacro:property name="d" value="0.1" />

    <xacro:property name="s1" value="${b/2+r}" />
    <xacro:property name="s2" value="${2*r}" />
    <xacro:property name="s3" value="${2*r}" />
    <xacro:property name="s4" value="${c/2+d/2}" />

   <!-- Mass and intertia - Robot is a box mass = density*volume moments of intertia equations for a box can be found via standard box formulas -->  
   <!-- For wheels mass = density*volume as well, for intertial values a standard wheel rotation is about the z axis -->
   <!-- For the central caster link the equations are the same but for a sphere mass=volume*density, moments of intertia are standard sphere formulas-->

   <!-- Material density-->
   <!-- Body material density -->
   xacro:<xacro:property name="d1" value="2710.0" />
   <!--wheel material density-->
   xacro:<xacro:property name="d2" value="2710.0" />
   <!-- caster material density-->
   xacro:<xacro:property name="d3" value="2710.0" />

   <!-- Robot body mass, wheel mass, caster mass-->
   <!--body-->
   xacro:<xacro:property name="m1" value="${d1*a*b*c}" />
   <!-- wheel-->
   xacro:<xacro:property name="m2" value="${d2*pi_const*r*r*d}" />
   <!-- caster-->
   xacro:<xacro:property name="m3" value="${d3*(4.0/3.0)*pi_const*r*r*r}" />


   <!-- body moment of itnertia-->
   xarco:<xacro:property name="Ix_body" value="${(1/12)*m1*(b*b+c*c)}" />
   xarco:<xacro:property name="Iy_body" value="${(1/12)*m1*(a*a+b*b)}" />
   xarco:<xacro:property name="Iz_body" value="${(1/12)*m1*(a*a+c*c)}" />

   <!-- wheel moment of intertias-->
   xarco:<xacro:property name="Iz_wheel" value="${0.5*m2*r*r}" />
   xarco:<xacro:property name="I_wheel" value="${(1.0/12.0)*m2*(3.0*r*r+d*d)}" />

   <!-- caster moment of intertia-->
   xarco:<xacro:property name="I_caster" value="${(2.0/5.0)*m3*r*r}" />

   <!-- defines intertial coordiante sections of robot things to be used later in code-->

   <!-- body-->
   xacro:<xacro:macro name="inertia_body">
      <intertial>
         <!-- diplacement and orientation of center of mass frame of the link -->
         <origin xyz="0.0 0.0 ${s1}" rpy="0.0 0.0 0.0"/>
         <mass value="${m1}"/>
         <inertia ixx="${Ix_body}" ixy="0.0" ixz="0.0" iyy="{Iy_body}" iyz="0.0" izz="{Iz_body}"/>
      </intertial>
   </xacro:macro>

   <!-- wheels-->
   xacro:<xacro:macro name="intertia_wheel">
      <intertial>
         <!-- diplacement and orientation of center of mass frame of the link -->
         <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
         <mass value="${m2}"/>
         <inertia ixx="${I_wheel}" ixy="0.0" ixz="0.0" iyy="{I_wheel}" iyz="0.0" izz="{Iz_wheel}"/>
      </intertial>
   </xacro:macro>

   <!-- caster -->
   xacro:<xacro:macro name="intertia_caster">
      <intertial>
         <!-- diplacement and orientation of center of mass frame of the link -->
         <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
         <mass value="${m3}"/>
         <inertia ixx="${I_caster}" ixy="0.0" ixz="0.0" iyy="{I_caster}" iyz="0.0" izz="{I_caster}"/>
      </intertial>
   </xacro:macro>

   <!-- include additional file-->

   <!-- incldue file that defines extra gazebo options and motion control driver-->
   xacro:<xacro:include filename="$(find mobile_robot)/model/robot.gazebo" />


   <!--base link (not an actual link , but used so gazebvo works)-->
   <link name="base_footprint"> </link>
   <joint name="body_link_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="body_link"/>
   </joint>

   <!-- body link-->
   <link name="body_link">
      <visual>
         <geometry>
            <box size="${a} ${c} ${b}"/>
         </geometry>

         <origin xyz="0.0 0.0 ${s1}" rpy="0.0 0.0 0.0"/>        
      </visual>

      <collision>
      <geometry>
         <box size="${a} ${c} ${b}"/>
      </geometry>
         <origin xyz="0.0 0.0 ${s1}" rpy="0.0 0.0 0.0"/>
         
      </collision>

      <xacro:intertia_body />
   </link>

   <!--right wheel and joint, rotated link as trhe z axis should be parallel to extrusion side by urdf ros-->
   <joint name="wheel1_joint" type="continuous">
      <origin xyz="${-s2} ${-s4} ${r}" rpy="0.0 0.0 0.0"/>
      <parent link="body_link"/>
      <child link="wheel1_link"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit effort="50000" velocity="10.0"/>
      <dynamics damping="1.0" friction="1.0"/>
   </joint>  

   <link name="wheel1_link">
      <visual>
         <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
         <geometry>
            <cylinder radius="${r}" length="${d}"/>
         </geometry>
      </visual>

      <collision>
         <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
         <geometry>
            <<cylinder radius="${r}" length="${d}"/>>
         </geometry>
      </collision>

      <xacro:intertia_wheel/>
   </link>

   <!--left wheen and joint-->
   <joint name="wheel2_joint" type="continuous">
      <origin xyz="${-s2} ${s4} ${r}" rpy="0.0 0.0 0.0"/>
      <parent link="body_link"/>
      <child link="wheel2_link"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit effort="50000" velocity="10.0"/>
      <dynamics damping="1.0" friction="1.0"/>
   </joint>  

   <link name="wheel2_link">
      <visual>
         <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
         <geometry>
            <cylinder radius="${r}" length="${d}"/>
         </geometry>
      </visual>

      <collision>
         <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
         <geometry>
            <<cylinder radius="${r}" length="${d}"/>>
         </geometry>
      </collision>

      <xacro:intertia_wheel/>
   </link>
 </robot>