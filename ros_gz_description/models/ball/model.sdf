<?xml version="1.0"?>
<sdf version="1.10">


    <model name='ball'>
        <pose>0 0 2.0 0 0 0</pose>

        <initial_velocity>0 -1.0 1.0 0 0 0</initial_velocity>

        <link name='sphere'>
            <visual name='visual'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient> <!-- Red RGBA color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>

            <collision name='collision'>
                <geometry>
                    <sphere>
                        <radius>0.5</radius>
                    </sphere>
                </geometry>
            </collision>
        </link>
    </model>
</sdf>