{
    "name": "ROS 2 Lyrical & Gazebo Jetty Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--gpus",
        "all",
        "-e",
        "DISPLAY=:0",
        "-e",
        "WAYLAND_DISPLAY=wayland-0",
        "-e",
        "XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir",
        "-e",
        "PULSE_SERVER=/mnt/wslg/PulseServer",
        "-v",
        "/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "-v",
        "/mnt/wslg:/mnt/wslg:ro"
    ],
    "forwardPorts": [
        8765
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python",
                "ms-vscode.cpptools"
            ]
        }
    }
}